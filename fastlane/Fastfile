default_platform(:ios)

platform :ios do
    lane :release do
		update_fastlane

		app_store_connect_api_key(
			key_id: "8SCSHM79PS",
			issuer_id: "69a6de80-224a-47e3-e053-5b8c7c11a4d1",
			key_filepath: "~/Developer/keystores/app-store-connect.p8",
			duration: 1200,
			in_house: false 
		)

		# Increment the build number (not the version number)
		increment_build_number(xcodeproj: "EmoticonKeyboard.xcodeproj")

		get_certificates
		get_provisioning_profile
		build_app

		# Upload to app store and wait for processing
		upload_to_app_store(
		    force: true,
		    automatic_release: true,
		    overwrite_screenshots: true,
			precheck_include_in_app_purchases: false
		)
    end
    lane :beta do
		update_fastlane

		# Increment the build number (not the version number)
		increment_build_number(xcodeproj: "EmoticonKeyboard.xcodeproj")

		get_certificates
		get_provisioning_profile
		build_app

		# Upload to testflight and wait for processing
		upload_to_testflight
    end
end
